{
  "apis": [
    {
      "name": "generateTravelPlan",
      "description": "根据用户目的地、天数、风格偏好生成完整旅行行程，包含每日景点安排、社交推荐和天气信息",
      "_meta": {
        "ui": { "componentPath": "components/itinerary-card" }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "description": "目的地城市名，如『西安』『成都』『北京』"
          },
          "days": {
            "type": "number",
            "description": "旅行天数"
          },
          "style": {
            "type": "string",
            "description": "旅行风格，可选：深度文化慢游 | 特种兵极限打卡 | 躺平休闲度假 | 摄影出片之旅"
          },
          "preferences": {
            "type": "string",
            "description": "用户额外偏好，如『喜欢美食』『带老人小孩』『预算有限』"
          }
        },
        "required": ["destination", "days"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "destination": { "type": "string" },
          "days": { "type": "number" },
          "dayPlanItinerary": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": { "type": "number" },
                "sequence": { "type": "number" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "time": { "type": "string" },
                "lat": { "type": "string" },
                "lng": { "type": "string" },
                "category": { "type": "string" },
                "weather_icon": { "type": "string" },
                "temperature": { "type": "string" },
                "transit_hint": { "type": "string" }
              }
            }
          },
          "socialRecommendations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": { "type": "number" },
                "title": { "type": "string" },
                "platform": { "type": "string" },
                "hot_score": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ],
  "components": [
    {
      "path": "components/itinerary-card",
      "relatedPage": "/pages/plan-detail/index"
    }
  ]
}
