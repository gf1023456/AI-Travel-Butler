.card {
  padding: 12px;
  background: #ffffff;
  border-radius: 8px;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 6px;
  flex-shrink: 0;
  border-bottom: 1px solid #c6c5d4;
  padding-bottom: 6px;
}
.header-top { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 15px; font-weight: 700; color: #191c1d; }
.days-badge {
  font-size: 10px; font-weight: 600; color: #0F4C5C;
  background: #E0FFFF; padding: 2px 8px; border-radius: 4px;
}
.style-tag { font-size: 10px; color: #454652; margin-top: 2px; display: block; }
.weather-bar { display: flex; gap: 8px; margin-top: 4px; }
.weather-item { display: flex; align-items: center; gap: 2px; }
.w-icon { font-size: 12px; }
.w-temp { font-size: 10px; color: #454652; }

.preview { flex-shrink: 1; overflow: hidden; }
.day-block {
  margin-bottom: 3px; display: flex; gap: 6px;
  background: #f3f4f5; border-radius: 6px;
  padding: 4px 6px;
}
.day-head { flex-shrink: 0; width: 22px; }
.day-label {
  font-size: 10px; font-weight: 600; color: #0F4C5C;
  background: #E0FFFF; padding: 0 4px; border-radius: 3px;
  display: inline-block;
}
.day-theme { font-size: 9px; color: #454652; display: block; }
.poi-chips { display: flex; flex-wrap: wrap; gap: 3px; }
.poi-chip {
  font-size: 11px; color: #191c1d;
  background: #ffffff; border-radius: 4px;
  padding: 2px 6px;
  border: 1px solid #c6c5d4;
}

.recommend { margin-top: 6px; flex-shrink: 0; padding-top: 6px; border-top: 1px solid #c6c5d4; }
.rec-scroll { display: flex; flex-direction: row; overflow-x: auto; white-space: nowrap; padding: 2px 0; }
.rec-chip {
  display: inline-flex; align-items: center; gap: 3px;
  background: #f3f4f5; border-radius: 14px;
  padding: 3px 8px; margin-right: 5px;
  border: 1px solid #c6c5d4;
}
.rec-chip:active { background: #e1e3e4; }
.rec-rank { font-size: 9px; font-weight: 600; color: #0F4C5C; }
.rec-name { font-size: 10px; color: #191c1d; }
.rec-score { font-size: 8px; color: #14B8A6; }

.btn {
  margin-top: 6px; flex-shrink: 0;
  border-radius: 6px; padding: 8px; text-align: center;
  background: linear-gradient(135deg, #0F4C5C 0%, #14B8A6 100%);
}
.btn:active { opacity: 0.85; }
.btn text { font-size: 12px; font-weight: 600; color: #ffffff; }
