<view class="card">
  <view class="header">
    <view class="header-top">
      <text class="title">{{destination}}</text>
      <text class="days-badge">{{daysNum}}天</text>
    </view>
    <text class="style-tag" wx:if="{{style}}">{{style}}</text>
    <view class="weather-bar" wx:if="{{weatherSummary.length}}">
      <view class="weather-item" wx:for="{{weatherSummary}}" wx:key="day">
        <text class="w-icon">{{item.icon}}</text>
        <text class="w-temp">{{item.temp}}</text>
      </view>
    </view>
  </view>

  <view class="preview" wx:if="{{allDays.length}}">
    <view class="day-block" wx:for="{{allDays}}" wx:key="day">
      <view class="day-head">
        <text class="day-label">D{{item.day}}</text>
        <text class="day-theme" wx:if="{{item.theme}}">{{item.theme}}</text>
      </view>
      <view class="poi-chips">
        <text class="poi-chip" wx:for="{{item.pois}}" wx:key="sequence" data-day="{{item.day}}" data-seq="{{item.sequence}}" catch:tap="onPoiTap">
          {{item.name}}
        </text>
      </view>
    </view>
  </view>

  <view class="recommend" wx:if="{{socialRecommendations.length}}">
    <scroll-view scroll-x class="rec-scroll">
      <view class="rec-chip" wx:for="{{socialRecommendations}}" wx:key="rank" data-name="{{item.title}}" catch:tap="onRecommendTap">
        <text class="rec-rank">#{{item.rank}}</text>
        <text class="rec-name">{{item.title}}</text>
        <text class="rec-score" wx:if="{{item.hot_score}}">{{item.hot_score}}</text>
      </view>
    </scroll-view>
  </view>

  <view catch:tap="onViewDetail" class="btn">
    <text>查看完整行程方案</text>
  </view>
</view>
