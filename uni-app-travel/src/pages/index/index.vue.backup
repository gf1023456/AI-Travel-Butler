<template>
  <view class="page-container">
    <!-- 地图 -->
    <map
      id="tianditu-map"
      class="map-container"
      :longitude="mapCenter[1]"
      :latitude="mapCenter[0]"
      :scale="mapZoom"
      :show-location="true"
      :enable-zoom="true"
      :enable-scroll="true"
      :enable-rotate="false"
      :enable-satellite="isSatellite"
      :polyline="polylines"
      :markers="markers"
      @markertap="onMarkerTap"
      @updated="onMapUpdated"
    />

    <!-- 顶部栏 -->
    <view class="top-bar">
      <view class="search-bar" @click="openExplorePanel">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索目的地或输入灵感...</text>
      </view>
      <view class="avatar-wrapper" @click="openSettings">
        <image class="avatar" :src="userInfo.avatar || defaultAvatar" mode="aspectFill" />
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-overlay" v-if="isLoading">
      <view class="loading-content">
        <view class="spinner">
          <view class="spinner-ring"></view>
          <view class="spinner-ring"></view>
          <view class="spinner-ring"></view>
        </view>
        <text class="loading-text">AI 正在思考...</text>
      </view>
    </view>

    <!-- 探索面板 -->
    <view class="side-panel explore-panel" :class="{ 'panel-active': activePanel === 'explore' }">
      <view class="panel-header">
        <view class="header-content">
          <text class="panel-title">灵感探索</text>
          <view class="model-tag">{{ currentModelName }}</view>
        </view>
        <view class="close-btn" @click="closePanel">✕</view>
      </view>

      <scroll-view scroll-y class="panel-body">
        <!-- 模式切换 -->
        <view class="section">
          <view class="mode-card">
            <view class="mode-content">
              <view class="mode-info">
                <text class="mode-name">{{ isPlannerMode ? '深度排期' : '快速探索' }}</text>
                <text class="mode-hint">{{ isPlannerMode ? '完整行程规划 · 多日安排' : '景点发现 · 轻量推荐' }}</text>
              </view>
              <switch :checked="isPlannerMode" @change="onModeToggle" color="#6366f1" />
            </view>
          </view>
        </view>

        <!-- 旅行风格 -->
        <view class="section" v-if="isPlannerMode">
          <text class="section-label">旅行风格</text>
          <view class="style-grid">
            <view
              v-for="(option, idx) in travelModeOptions"
              :key="idx"
              :class="['style-item', travelModeIndex === idx ? 'style-active' : '']"
              @click="travelModeIndex = idx"
            >
              <text class="style-icon">{{ option.label.split(' ')[0] }}</text>
              <text class="style-name">{{ option.label.split(' ').slice(1).join(' ') }}</text>
            </view>
          </view>
        </view>

        <!-- 输入区域 -->
        <view class="section section-main">
          <view class="input-card">
            <textarea
              class="main-input"
              v-model="userInput"
              placeholder="描述你的旅行想法，例如：我想去云南，5 天时间，喜欢自然风光和美食..."
              :auto-height="true"
              :maxlength="500"
            />
            <view class="input-footer">
              <text class="char-count">{{ charCount }} / 500</text>
              <button
                class="generate-btn"
                :loading="travelStore.loading"
                :disabled="travelStore.loading || !userInput.trim()"
                @click="handleGenerate"
              >
                <text>{{ isPlannerMode ? '生成完整行程' : '开始探索' }}</text>
              </button>
            </view>
          </view>
        </view>

        <!-- 底部提示 -->
        <view class="section section-hint">
          <text class="hint-text">💡 AI 将根据你的描述，智能推荐最佳行程方案</text>
        </view>
      </scroll-view>
    </view>

    <!-- 行程面板 -->
    <view class="side-panel plan-panel" :class="{ 'panel-active': activePanel === 'plan' }">
      <view class="panel-header">
        <text class="panel-title">行程方案</text>
        <view class="header-actions">
          <view class="action-icon" @click="saveToHistory">💾</view>
          <view class="action-icon" @click="copyToClipboard">📋</view>
          <view class="action-icon" @click="exportToFile">📥</view>
          <view class="close-btn" @click="closePanel">✕</view>
        </view>
      </view>

      <scroll-view scroll-y class="panel-body plan-body">
        <view v-if="!travelStore.currentPlan" class="empty-state">
          <view class="empty-icon">🗺️</view>
          <text class="empty-title">暂无行程</text>
          <text class="empty-desc">在探索面板中创建你的第一个行程</text>
        </view>

        <view v-else class="plan-content">
          <!-- 行程摘要 -->
          <view class="summary-card">
            <text class="summary-text">{{ itinerarySummary }}</text>
          </view>

          <!-- 每日行程 -->
          <view class="days-container">
            <view
              v-for="(item, index) in sortedItinerary"
              :key="index"
              class="day-card"
              :style="{ borderLeftColor: getDayColor(item.day) }"
              @click="flyToMarker(item)"
            >
              <view class="day-header">
                <view class="day-label" :style="{ background: getDayColor(item.day) }">
                  <text class="day-label-text">D{{ item.day }}</text>
                </view>
                <text class="time-label">{{ item.time }}</text>
              </view>
              <text class="place-name">{{ item.name }}</text>
              <text class="place-desc">{{ item.description }}</text>
              <view v-if="item.city || (item.weather_icon && item.temperature)" class="place-meta">
                <text v-if="item.city" class="meta-item">📍 {{ item.city }}</text>
                <text v-if="item.weather_icon && item.temperature" class="meta-item">{{ item.weather_icon }} {{ item.temperature }}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 底部导航 -->
    <view class="bottom-nav">
      <view class="nav-item" :class="{ active: activeNav === 'explore' }" @click="activeNav = 'explore'; openExplorePanel()">
        <view class="nav-icon-bg">
          <text class="nav-icon">🧭</text>
        </view>
        <text class="nav-label">探索</text>
      </view>
      <view class="nav-item" :class="{ active: activeNav === 'plan' }" @click="activeNav = 'plan'; openPlanPanel()">
        <view class="nav-icon-bg">
          <text class="nav-icon">📅</text>
        </view>
        <text class="nav-label">行程</text>
      </view>
      <view class="nav-item" :class="{ active: activeNav === 'layers' }" @click="toggleMapType()">
        <view class="nav-icon-bg">
          <text class="nav-icon">{{ isSatellite ? '🛰️' : '🗺️' }}</text>
        </view>
        <text class="nav-label">{{ isSatellite ? '地图' : '卫星' }}</text>
      </view>
      <view class="nav-item" :class="{ active: activeNav === 'history' }" @click="activeNav = 'history'; showHistory = true">
        <view class="nav-icon-bg">
          <text class="nav-icon">🕐</text>
        </view>
        <text class="nav-label">历史</text>
      </view>
      <view class="nav-item" :class="{ active: activeNav === 'settings' }" @click="activeNav = 'settings'; openSettings()">
        <view class="nav-icon-bg">
          <text class="nav-icon">👤</text>
        </view>
        <text class="nav-label">我的</text>
      </view>
    </view>

    <!-- 历史弹窗 -->
    <view class="modal-overlay" v-if="showHistory" @click="showHistory = false">
      <view class="modal" @click.stop>
        <view class="modal-header">
          <text class="modal-title">历史记录</text>
          <view class="modal-close" @click="showHistory = false">✕</view>
        </view>
        <scroll-view scroll-y class="modal-body">
          <view v-if="historyList.length === 0" class="modal-empty">
            <text>暂无历史记录</text>
          </view>
          <view
            v-for="item in historyList"
            :key="item.id"
            class="history-item"
            @click="loadHistory(item)"
          >
            <view class="history-content">
              <text class="history-time">{{ item.timestamp }}</text>
              <text class="history-text">{{ item.prompt.substring(0, 45) }}...</text>
            </view>
            <view class="history-delete" @click.stop="deleteHistory(item.id)">🗑️</view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 设置弹窗 -->
    <view class="modal-overlay" v-if="showSettings" @click="showSettings = false">
      <view class="modal modal-settings" @click.stop>
        <view class="modal-header">
          <text class="modal-title">个人信息</text>
          <view class="modal-close" @click="showSettings = false">✕</view>
        </view>
        <scroll-view scroll-y class="modal-body">
          <!-- 头像 -->
          <view class="avatar-section">
            <image
              :src="userInfo.avatar || defaultAvatar"
              class="avatar-large"
              mode="aspectFill"
              @click="chooseAvatar"
            />
            <text class="avatar-hint">点击更换</text>
          </view>

          <!-- 昵称 -->
          <view class="form-group">
            <text class="form-label">昵称</text>
            <input class="form-input" v-model="userInfo.nickname" placeholder="请输入昵称" @blur="saveUserInfo" />
          </view>

          <!-- 配额信息 -->
          <view class="form-group">
            <text class="form-label">今日配额</text>
            <view class="quota-display">
              <text class="quota-value">{{ userStore.quota.remaining }}</text>
              <text class="quota-divider">/</text>
              <text class="quota-max">{{ userStore.quota.max + userStore.quota.bonus }}</text>
              <view class="quota-bonus" v-if="userStore.quota.bonus > 0">
                <text>额外 +{{ userStore.quota.bonus }}</text>
              </view>
            </view>
            <button class="bonus-btn" @click="shareApp" v-if="userStore.quota.bonus < 3">
              <text>分享获取额外配额 (+3)</text>
            </button>
          </view>

          <!-- 账户信息 -->
          <view class="form-group">
            <text class="form-label">账户信息</text>
            <view class="info-row">
              <text class="info-label">用户 ID</text>
              <text class="info-value">{{ userStore.userId || '未登录' }}</text>
            </view>
            <view class="info-row">
              <text class="info-label">退出登录</text>
              <text class="info-value" @click="logout" style="color: #ef4444;">点击退出</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 标注点详情 -->
    <view class="modal-overlay" v-if="showMarkerDetail" @click="showMarkerDetail = false">
      <view class="modal" @click.stop>
        <view class="modal-header marker-header" :style="{ background: `linear-gradient(135deg, ${selectedMarker.dayColor}, ${selectedMarker.dayColor}cc)` }">
          <view class="marker-header-content">
            <view class="day-tag">Day {{ selectedMarker.day }}</view>
            <text class="modal-title marker-title">{{ selectedMarker.name }}</text>
            <text v-if="selectedMarker.city" class="city-tag">{{ selectedMarker.city }}</text>
          </view>
          <view class="modal-close" @click="showMarkerDetail = false">✕</view>
        </view>
        <scroll-view scroll-y class="modal-body">
          <view class="detail-row">
            <text class="detail-label">📅 时间</text>
            <text class="detail-value">{{ selectedMarker.time }}</text>
          </view>
          <view v-if="selectedMarker.weather_icon && selectedMarker.temperature" class="detail-row">
            <text class="detail-label">🌤️ 天气</text>
            <text class="detail-value">{{ selectedMarker.weather_icon }} {{ selectedMarker.temperature }}</text>
          </view>
          <view v-if="selectedMarker.description" class="detail-row">
            <text class="detail-label">📖 介绍</text>
            <text class="detail-value detail-desc">{{ selectedMarker.description }}</text>
          </view>
          <view v-if="selectedMarker.transit_hint" class="detail-row">
            <text class="detail-label">🚗 交通</text>
            <text class="detail-value">{{ selectedMarker.transit_hint }}</text>
          </view>
          <view v-if="selectedMarker.visit_duration" class="detail-row">
            <text class="detail-label">⏱️ 游玩时长</text>
            <text class="detail-value">{{ selectedMarker.visit_duration }}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- Toast -->
    <view class="toast-wrap">
      <view v-if="toast.show" :class="['toast', toast.type, 'toast-visible']">
        <text>{{ toast.message }}</text>
      </view>
    </view>
  </view>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'
import { useTravelStore } from '@/store/travel.js'
import { useUserStore } from '@/store/user.js'
import { getCurrentModel } from '@/api/travel.js'
import { getUserInfo } from '@/api/user.js'
import { getQuota, addQuotaBonus } from '@/api/quota.js'
import { saveHistory, getHistoryList, deleteHistory as deleteHistoryApi } from '@/api/history.js'

const travelStore = useTravelStore()
const userStore = useUserStore()

// 地图
const mapCenter = ref([34.3416, 108.9398])
const mapZoom = ref(12)
const isSatellite = ref(false)

// 面板
const activePanel = ref(null)
const activeNav = ref('explore')

// 弹窗
const showHistory = ref(false)
const showSettings = ref(false)
const showMarkerDetail = ref(false)
const selectedMarker = ref({})

// 表单
const userInput = ref('')
const isPlannerMode = ref(false)
const travelModeIndex = ref(0)

// 数据
const markers = ref([])
const polylines = ref([])
const dayPlanItinerary = ref([])
const socialRecommendations = ref([])
const itinerarySummary = ref('')
const itineraryEvidence = ref([])
const verifierWarnings = ref([])

// 状态
const isLoading = ref(false)
const toast = ref({ show: false, message: '', type: 'normal' })

// 历史
const historyList = ref([])
const STORAGE_KEY = 'travel_history'

// 用户
const defaultAvatar = 'https://api.dicebear.com/7.x/avataaars/svg?seed=Traveler'
const userInfo = computed(() => ({
  nickname: userStore.nickname || '',
  avatar: userStore.avatarUrl || '',
  userId: userStore.userId || ''
}))

// 模型
const currentModelName = ref('Gemini Pro')

// 颜色
const DAY_COLORS = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A', '#98FB98', '#DDA0DD', '#F0E68C', '#FF6347', '#BA55D3', '#9ACD32']

const travelModeOptions = [
  { label: '🍵 深度文化慢游', value: 'deep' },
  { label: '🔥 特种兵极限打卡', value: 'special' },
  { label: '🏖️ 躺平休闲度假', value: 'relax' },
  { label: '📸 摄影出片之旅', value: 'photo' }
]

const charCount = computed(() => userInput.value.length)
const sortedItinerary = computed(() => [...dayPlanItinerary.value].sort((a, b) => (a.day - b.day) || (a.sequence - b.sequence)))
const getDayColor = (day) => DAY_COLORS[(day - 1) % DAY_COLORS.length]

onMounted(async () => {
  loadHistoryFromStorage()
  loadUserInfo()
  fetchCurrentModel()
  await initUserAuth()
})

// 面板操作
const openExplorePanel = () => { activeNav.value = 'explore'; activePanel.value = 'explore' }
const openPlanPanel = () => {
  if (travelStore.currentPlan) {
    activeNav.value = 'plan'
    activePanel.value = 'plan'
  } else showToast('请先生成行程', 'error')
}
const closePanel = () => { activePanel.value = null }

// 地图
const toggleMapType = () => {
  isSatellite.value = !isSatellite.value
  showToast(isSatellite.value ? '已切换卫星地图' : '已切换普通地图', 'normal', 1500)
}

// 模式
const onModeToggle = (e) => { isPlannerMode.value = e.detail.value }

// 地图事件
const onMarkerTap = (e) => {
  const marker = markers.value.find(m => m.id === e.markerId)
  if (marker?.detail) {
    selectedMarker.value = marker.detail
    showMarkerDetail.value = true
    mapCenter.value = [marker.latitude, marker.longitude]
    mapZoom.value = 15
  }
}
const onMapUpdated = () => console.log('地图加载完成')

// 飞到标注点
const flyToMarker = (item) => {
  if (item.lat && item.lng) {
    mapCenter.value = [parseFloat(item.lat), parseFloat(item.lng)]
    mapZoom.value = 15
    showToast(`Day ${item.day} - ${item.name}`, 'normal', 2000)
  }
}

// 生成
const handleGenerate = async () => {
  if (!userInput.value.trim()) { showToast('请输入旅行想法', 'error'); return }
  isLoading.value = true
  closePanel()
  try {
    const result = await travelStore.createPlan({
      userInput: userInput.value,
      modelType: 'auto',
      isPlannerMode: isPlannerMode.value,
      travelMode: travelModeOptions[travelModeIndex.value].value
    })
    updatePlanData(result)
    addMarkersFromPlan(result)
    
    // 保存到历史记录
    try {
      await saveHistory({
        userInput: userInput.value,
        modelType: 'auto',
        provider: result.provider || 'unknown',
        itinerarySummary: result.itinerarySummary || '',
        dayPlan: result.dayPlanItinerary || [],
        socialRecommendations: result.socialRecommendations || [],
        evidence: result.evidence || [],
        warnings: result.warnings || []
      })
      console.log('行程已保存到历史记录')
    } catch (e) {
      console.log('保存历史失败', e)
    }
    
    showToast('行程生成成功', 'success')
    setTimeout(() => openPlanPanel(), 500)
  } catch (error) {
    showToast(error.message || '服务暂时不可用', 'error', 5000)
  } finally {
    isLoading.value = false
  }
}

const updatePlanData = (result) => {
  dayPlanItinerary.value = Array.isArray(result.dayPlanItinerary) ? result.dayPlanItinerary : []
  socialRecommendations.value = Array.isArray(result.socialRecommendations) ? result.socialRecommendations : []
  itinerarySummary.value = result.itinerarySummary || '排期已生成'
  itineraryEvidence.value = Array.isArray(result.evidence) ? result.evidence : []
  verifierWarnings.value = Array.isArray(result.verifierWarnings) ? result.verifierWarnings : []
}

const addMarkersFromPlan = (plan) => {
  if (!plan?.dayPlanItinerary) return
  const newMarkers = []
  const pointsByDay = {}
  plan.dayPlanItinerary.forEach((item, index) => {
    if (!item.lat || !item.lng) return
    const lat = parseFloat(item.lat), lng = parseFloat(item.lng)
    if (isNaN(lat) || isNaN(lng)) return
    const dayColor = getDayColor(item.day)
    newMarkers.push({
      id: index,
      latitude: lat,
      longitude: lng,
      title: item.name,
      iconPath: '/static/images/marker-icon.png',
      width: 32, height: 32,
      anchor: { x: 0.5, y: 1 },
      callout: {
        content: item.name, display: 'ALWAYS', padding: 8, borderRadius: 10, fontSize: 12,
        bgColor: dayColor, color: '#FFFFFF', textAlign: 'center', borderWidth: 2, borderColor: '#FFFFFF'
      },
      label: {
        content: `Day${item.day}`, color: dayColor, fontSize: 12, fontWeight: 'bold',
        borderRadius: 5, padding: 3, bgColor: '#FFFFFF', anchorX: 0, anchorY: -40
      },
      detail: {
        id: index, name: item.name, day: item.day, dayColor, time: item.time, city: item.city,
        description: item.description, transit_hint: item.transit_hint, visit_duration: item.visit_duration,
        weather_icon: item.weather_icon, temperature: item.temperature, lat, lng
      }
    })
    if (!pointsByDay[item.day]) pointsByDay[item.day] = []
    pointsByDay[item.day].push({ latitude: lat, longitude: lng })
  })
  markers.value = newMarkers
  const newPolylines = []
  Object.keys(pointsByDay).forEach(dayKey => {
    const day = parseInt(dayKey), points = pointsByDay[day]
    if (points.length > 1) {
      newPolylines.push({ points, color: getDayColor(day), width: 5, dottedLine: false, arrowLine: false, borderColor: '#FFFFFF', borderWidth: 2 })
    }
  })
  polylines.value = newPolylines
  if (newMarkers.length > 0) { mapCenter.value = [newMarkers[0].latitude, newMarkers[0].longitude]; mapZoom.value = 14 }
}

// Toast
const showToast = (message, type = 'normal', duration = 3000) => {
  toast.value = { show: true, message, type }
  setTimeout(() => { toast.value.show = false }, duration)
}

// 历史
const saveToHistory = () => {
  if (!dayPlanItinerary.value.length) { showToast('无行程可保存', 'error'); return }
  const history = JSON.parse(uni.getStorageSync(STORAGE_KEY) || '[]')
  if (history.length && history[0].prompt === userInput.value && JSON.stringify(history[0].itinerary) === JSON.stringify(dayPlanItinerary.value)) {
    showToast('已在历史中', 'normal'); return
  }
  history.unshift({
    id: Date.now(), timestamp: new Date().toLocaleString(), prompt: userInput.value,
    summary: itinerarySummary.value, itinerary: dayPlanItinerary.value,
    recommendations: socialRecommendations.value, evidence: itineraryEvidence.value, warnings: verifierWarnings.value
  })
  if (history.length > 30) history.pop()
  uni.setStorageSync(STORAGE_KEY, JSON.stringify(history))
  loadHistoryFromStorage()
  showToast('保存成功', 'success')
}

const loadHistoryFromStorage = async () => {
  // 尝试从后端加载
  try {
    const data = await getHistoryList(1, 20, false)
    if (data && data.list && data.list.length > 0) {
      historyList.value = data.list
      return
    }
  } catch (e) {
    console.log('从后端加载历史失败，使用本地存储', e)
  }
  // 后端失败则用本地
  historyList.value = JSON.parse(uni.getStorageSync(STORAGE_KEY) || '[]')
}

const loadHistory = (item) => {
  markers.value = []; polylines.value = []; dayPlanItinerary.value = []
  socialRecommendations.value = []; itinerarySummary.value = ''; itineraryEvidence.value = []; verifierWarnings.value = []
  setTimeout(() => {
    dayPlanItinerary.value = item.itinerary || []
    itinerarySummary.value = item.summary || ''
    socialRecommendations.value = item.recommendations || []
    itineraryEvidence.value = item.evidence || []
    verifierWarnings.value = item.warnings || []
    userInput.value = item.prompt || ''
    addMarkersFromPlan({ dayPlanItinerary: item.itinerary })
    if (markers.value.length > 0) { mapCenter.value = [markers.value[0].latitude, markers.value[0].longitude]; mapZoom.value = 14 }
    showHistory.value = false
    showToast('已加载', 'success')
    setTimeout(() => openPlanPanel(), 500)
  }, 100)
}

const deleteHistory = (id) => {
  uni.showModal({
    title: '确认删除', content: '确定删除这条记录？',
    success: async (res) => {
      if (res.confirm) {
        // 尝试从后端删除
        try {
          await deleteHistoryApi(id)
        } catch (e) {
          console.log('后端删除失败', e)
        }
        // 更新本地列表
        let history = JSON.parse(uni.getStorageSync(STORAGE_KEY) || '[]')
        history = history.filter(i => i.id !== id)
        uni.setStorageSync(STORAGE_KEY, JSON.stringify(history))
        loadHistoryFromStorage()
        showToast('已删除', 'success')
      }
    }
  })
}

// 复制导出
const copyToClipboard = () => {
  if (!dayPlanItinerary.value.length && !itinerarySummary.value) { showToast('无内容', 'error'); return }
  uni.setClipboardData({ data: generatePlainTextGuide(), success: () => showToast('已复制', 'success'), fail: () => showToast('复制失败', 'error') })
}

const exportToFile = () => {
  if (!dayPlanItinerary.value.length) { showToast('无行程', 'error'); return }
  uni.showModal({ title: '导出行程', content: '已将行程复制到剪贴板', showCancel: false, success: () => copyToClipboard() })
}

const generatePlainTextGuide = () => {
  let text = `🌍 AI Travel Pro 行程指南\n📅 ${new Date().toLocaleString()}\n🎯 ${userInput.value}\n\n`
  if (itinerarySummary.value) text += `📝 亮点\n${itinerarySummary.value}\n\n`
  if (socialRecommendations.value.length) {
    text += `🔥 热门打卡\n`
    socialRecommendations.value.forEach((item, i) => { text += `${i+1}. ${item.title} [${item.platform}] - ${item.reason}\n` })
    text += '\n'
  }
  if (dayPlanItinerary.value.length) {
    text += `🗺️ 每日行程\n`
    const days = {}
    dayPlanItinerary.value.forEach(item => { if (!days[item.day]) days[item.day] = []; days[item.day].push(item) })
    Object.keys(days).sort().forEach(day => {
      text += `\n【Day ${day}】\n`
      days[day].forEach(item => {
        const city = item.city ? `(${item.city})` : ''
        const weather = item.weather_icon && item.temperature ? ` [${item.weather_icon} ${item.temperature}]` : ''
        text += `📍 ${item.sequence}. ${item.name} ${city}\n   ⏰ ${item.time}${weather}\n   📖 ${item.description}\n`
        if (item.transit_hint) text += `   🚗 ${item.transit_hint}\n`
        text += `   ────────────────────\n`
      })
    })
  }
  return text
}

// 设置
const openSettings = () => { showSettings.value = true }
const saveUserInfo = () => { 
  uni.setStorageSync('user_nickname', userStore.nickname)
  showToast('已保存', 'success') 
}
const loadUserInfo = () => {
  userStore.restoreFromStorage()
}
const chooseAvatar = () => {
  uni.chooseImage({ count: 1, sourceType: ['album', 'camera'], success: (res) => { userInfo.value.avatar = res.tempFilePaths[0]; saveUserInfo() } })
}

// 获取模型
const fetchCurrentModel = async () => {
  try {
    const result = await getCurrentModel()
    if (result?.modelName) currentModelName.value = result.modelName
  } catch (e) { currentModelName.value = 'Gemini Pro' }
}

// 用户认证初始化
const initUserAuth = async () => {
  try {
    const info = await getUserInfo()
    console.log('用户信息获取成功:', info)
    if (info) {
      userStore.nickname = info.nickname || userStore.nickname
      userStore.avatarUrl = info.avatar_url || userStore.avatarUrl
    }
    await refreshQuota()
  } catch (e) {
    console.log('获取用户信息失败，跳转登录', e.message)
    userStore.clearLogin()
    uni.reLaunch({ url: '/pages/login/index' })
  }
}

// 刷新配额
const refreshQuota = async () => {
  try {
    const quota = await getQuota()
    if (quota) {
      userStore.setQuota(quota)
    }
  } catch (e) {
    console.log('获取配额失败', e)
  }
}

// 重启
const restart = () => {
  markers.value = []; polylines.value = []; dayPlanItinerary.value = []
  socialRecommendations.value = []; itinerarySummary.value = ''; itineraryEvidence.value = []; verifierWarnings.value = []
}

// 分享获取配额
const shareApp = () => {
  uni.showShareMenu({
    withShareTicket: true,
    menus: ['shareAppMessage', 'shareTimeline']
  })
  uni.share({
    provider: 'weixin',
    type: 0,
    title: 'AI Travel Pro - 智能旅行助手',
    scene: 'WXSceneSession',
    success: async () => {
      try {
        await addQuotaBonus(3)
        showToast('配额 +3', 'success')
      } catch (e) {
        showToast('分享成功', 'success')
      }
    },
    fail: () => {
      showToast('分享取消', 'none')
    }
  })
}

// 退出登录
const logout = () => {
  uni.showModal({
    title: '确认退出',
    content: '确定退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        userStore.clearLogin()
        uni.reLaunch({ url: '/pages/login/index' })
      }
    }
  })
}
</script>

