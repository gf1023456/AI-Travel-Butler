# AI Travel Butler - Docker 环境变量配置
# 复制此文件为 .env 并填写你的 API Keys

# ===========================================
# AI Provider API Keys (至少配置一个)
# ===========================================

# Google Gemini API (推荐，免费额度大)
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 智谱 GLM API
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 阿里云通义千问 API
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# ===========================================
# 服务器配置
# ===========================================
PORT=8787
REQUEST_TIMEOUT_MS=120000
MAX_RETRIES=3

# ===========================================
# 外部 API Keys
# ===========================================
AMAP_API_KEY=
WEATHER_API_KEY=
TDT_API_KEY=97f9870fb795ba80ef201d6edae71d73

# ===========================================
# 前端配置
# ===========================================
BACKEND_URL=http://localhost:8787

# ===========================================
# 数据库配置
# ===========================================
DATABASE_URL=postgresql://postgres:147258@localhost:5432/ai_travel_butler

# ===========================================
# 微信小程序配置
# ===========================================
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret