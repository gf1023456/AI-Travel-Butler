# AI Travel Butler 环境变量配置

# ========== 必填：AI Provider API Keys ==========
# 至少填一个，推荐填 Gemini（免费额度大）
GEMINI_API_KEY=你的Gemini_API_Key
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
ZHIPU_API_KEY=你的智谱_API_Key
DASHSCOPE_API_KEY=你的阿里云DashScope_API_Key

# ========== 可选配置 ==========
# 自定义后端访问地址（如果用 nginx 代理）
BACKEND_URL=http://tonystark-ai.ccwu.cc/aiTraver

# 天地图 API Key（前端地图）
TDT_API_KEY=97f9870fb795ba80ef201d6edae71d73

# ========== 使用说明 ==========
# 1. 复制此文件为 .env
# 2. 填入你的 API Key
# 3. 运行: docker-compose up -d
# 4. 访问: http://localhost:3000 或你的域名