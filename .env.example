# AI Travel Butler - 完整项目环境变量配置

# ===========================================
# AI Provider API Keys (至少配置一个)
# ===========================================

# Google Gemini API (推荐，免费额度大)
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 智谱 GLM API
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 阿里云通义千问 API
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# ===========================================
# 服务器配置
# ===========================================

# Node 后端端口
NODE_PORT=8786

# Python 后端端口
PYTHON_PORT=8787

# 前端端口
FRONTEND_PORT=3000

# 请求超时（毫秒）
REQUEST_TIMEOUT_MS=120000

# 最大重试次数
MAX_RETRIES=3

# ===========================================
# 外部 API Keys
# ===========================================

# 高德地图 API Key
AMAP_API_KEY=

# 天气 API Key
WEATHER_API_KEY=

# 天地图 API Key（默认已填）
TDT_API_KEY=97f9870fb795ba80ef201d6edae71d73

# ===========================================
# 前端配置
# ===========================================

# 后端地址（前端调用）
BACKEND_URL=http://localhost:8787